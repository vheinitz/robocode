<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Titelzeile: kleines „RoboCode" + Verbindungsstatus -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RoboCode"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView android:id="@+id/btnProject"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:background="@drawable/bg_icon_button"
            android:textSize="12sp" android:textColor="#374151"
            android:maxWidth="150dp" android:singleLine="true" android:ellipsize="end"
            android:text="Projekt ▾" android:clickable="true" android:focusable="true" />

        <TextView android:id="@+id/txtStatus"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="12sp"
            android:text="● nicht verbunden"
            android:textColor="#c0392b" />
    </LinearLayout>

    <!-- Top-Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1a1f27">

        <Button android:id="@+id/navCode" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Code" android:textSize="11sp" android:padding="2dp" android:singleLine="true" />
        <Button android:id="@+id/navBoard" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Board" android:textSize="11sp" android:padding="2dp" android:singleLine="true" />
        <Button android:id="@+id/navDevice" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Gerät" android:textSize="11sp" android:padding="2dp" android:singleLine="true" />
        <Button android:id="@+id/navMain" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="main.py" android:textSize="11sp" android:padding="2dp" android:singleLine="true" />
        <Button android:id="@+id/navTerminal" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Term" android:textSize="11sp" android:padding="2dp" android:singleLine="true" />
        <Button android:id="@+id/navLog" style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Log" android:textSize="11sp" android:padding="2dp" android:singleLine="true" />
    </LinearLayout>

    <!-- ===================== Panel: CODE ===================== -->
    <LinearLayout android:id="@+id/panelCode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Sub-Tabs SETUP/MAIN/LIB: in dieser Variante ausgeblendet (nur MAIN) -->
        <LinearLayout android:id="@+id/tabRow"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:visibility="gone">
            <Button android:id="@+id/tabSetup" style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="SETUP" />
            <Button android:id="@+id/tabMain" style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="MAIN" />
            <Button android:id="@+id/tabLib" style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="LIB" />
        </LinearLayout>

        <!-- Werkzeugzeile: Start-Dreieck ganz links + Gruppen-Palette -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingTop="4dp" android:paddingBottom="2dp">
            <ImageButton android:id="@+id/btnStart"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:src="@drawable/ic_start"
                android:background="@drawable/bg_icon_button"
                android:scaleType="fitCenter" android:adjustViewBounds="true"
                android:padding="7dp" android:layout_marginEnd="6dp"
                android:contentDescription="Start — übertragen und ausführen"
                android:enabled="false" />
            <HorizontalScrollView android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:scrollbars="none">
                <LinearLayout android:id="@+id/palette"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
            <!-- Fester Zuweisungs-Knopf rechts (immer sichtbar, nicht scrollbar). -->
            <TextView android:id="@+id/btnAssign"
                android:layout_width="34dp" android:layout_height="30dp"
                android:text="=" android:textSize="15sp" android:gravity="center"
                android:textColor="#374151" android:background="@drawable/bg_icon_button"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace" android:clickable="true" android:focusable="true" />
        </LinearLayout>
        <!-- Palette: aufgeklappte Unter-Zeile (Inhalt der gewählten Gruppe) -->
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:paddingBottom="2dp">
            <LinearLayout android:id="@+id/paletteSub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" android:visibility="gone" />
        </HorizontalScrollView>

        <EditText android:id="@+id/editor"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace" android:textSize="13sp"
            android:importantForAutofill="no"
            android:background="#12151b" android:textColor="#e6e9ef" android:padding="6dp" />

        <!-- Edit-Leiste: Tab, Backspace, Zeile löschen, Zeile hoch/runter -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp">
            <TextView android:id="@+id/edTab" android:text="⇥"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
                android:gravity="center" android:textSize="16sp" android:textColor="#374151"
                android:background="@drawable/bg_icon_button" android:layout_marginEnd="4dp"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/edBack" android:text="⌫"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
                android:gravity="center" android:textSize="16sp" android:textColor="#374151"
                android:background="@drawable/bg_icon_button" android:layout_marginEnd="4dp"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/edDelLine" android:text="⌦ Zeile"
                android:layout_width="0dp" android:layout_weight="1.4" android:layout_height="32dp"
                android:gravity="center" android:textSize="13sp" android:textColor="#374151"
                android:background="@drawable/bg_icon_button" android:layout_marginEnd="4dp"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/edUp" android:text="↑"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
                android:gravity="center" android:textSize="16sp" android:textColor="#374151"
                android:background="@drawable/bg_icon_button" android:layout_marginEnd="4dp"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/edDown" android:text="↓"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="32dp"
                android:gravity="center" android:textSize="16sp" android:textColor="#374151"
                android:background="@drawable/bg_icon_button"
                android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== Panel: BOARD (0.2 — Pin-Belegung) ===================== -->
    <LinearLayout android:id="@+id/panelBoard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Kopfzeile: Board-Auswahl + Klonen/Standard (flach, minimaler Rand) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="#f3f4f6"
            android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp">
            <Spinner android:id="@+id/spinnerBoardCfg"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="0dp" android:paddingTop="0dp" android:paddingBottom="0dp" />
            <Button android:id="@+id/btnBoardClone" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="0dp" android:minWidth="0dp"
                android:text="Klonen" android:textSize="11sp" />
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:background="#ffffff">
            <!-- Wird in Code gefüllt: linke Pins | Board-Bild | rechte Pins.
                 Horizontal scrollbar, da 3 Spalten + Bild breiter als der Schirm. -->
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none" android:padding="4dp">
                <LinearLayout android:id="@+id/boardRow"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" />
            </HorizontalScrollView>
        </ScrollView>
    </LinearLayout>

    <!-- ===================== Panel: GERÄT ===================== -->
    <LinearLayout android:id="@+id/panelDevice"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView android:id="@+id/txtDeviceInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:paddingBottom="10dp"
            android:text="Noch nicht verbunden." />

        <Button android:id="@+id/btnConnect"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Verbinden &amp; prüfen" />
        <Button android:id="@+id/btnInstall"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="MicroPython installieren" android:enabled="false" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Board (autom.):" android:paddingEnd="6dp" />
            <Spinner android:id="@+id/spinnerBoard"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#8a93a2" android:paddingTop="10dp"
            android:text="Zum Installieren den ESP32 per BOOT/EN in den Download-Modus bringen (die App sagt es an). Das Board wird beim Verbinden automatisch erkannt; der Regler ist nur zur Korrektur." />

        <Button android:id="@+id/btnInfo" style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ℹ Info &amp; Lizenzen" />
    </LinearLayout>

    <!-- ===================== Panel: main.py ===================== -->
    <LinearLayout android:id="@+id/panelMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="end">
            <Button android:id="@+id/btnCopyMain" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kopieren" />
            <Button android:id="@+id/btnDownloadMain" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⤓ speichern" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:id="@+id/mainPyView"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="11sp" android:padding="6dp"
                android:background="#12151b" android:textColor="#e6e9ef" android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>

    <!-- ===================== Panel: TERMINAL (seriell, wie Arduino-SerMonitor) ===================== -->
    <LinearLayout android:id="@+id/panelTerminal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Terminal — serielle Ein-/Ausgabe" android:textSize="11sp" android:textColor="#8a93a2" />
            <Button android:id="@+id/btnTerminalStop" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stop" />
            <Button android:id="@+id/btnTerminalClear" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="leeren" />
        </LinearLayout>

        <!-- IN: eingehende Ausgabe des Programms, scrollbar -->
        <ScrollView android:id="@+id/terminalInScroll"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:background="#12151b">
            <TextView android:id="@+id/terminalIn"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="12sp" android:padding="6dp"
                android:textColor="#9be7a0" android:textIsSelectable="true" />
        </ScrollView>

        <!-- OUT: eine Zeile zum Senden an den ESP32 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp">
            <EditText android:id="@+id/terminalOut"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:hint="Zeile senden…" android:singleLine="true"
                android:inputType="text|textNoSuggestions"
                android:imeOptions="actionSend"
                android:fontFamily="monospace" android:textSize="13sp"
                android:importantForAutofill="no" />
            <Button android:id="@+id/btnTerminalSend" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Senden" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== Panel: LOG ===================== -->
    <LinearLayout android:id="@+id/panelLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <Button android:id="@+id/btnClearLog" style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Log leeren" android:layout_gravity="end" />
        <ScrollView android:id="@+id/logScroll"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <TextView android:id="@+id/log"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="monospace" android:textSize="12sp" android:padding="4dp"
                android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
