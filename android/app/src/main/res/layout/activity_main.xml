<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Kopf: Board + Aktionen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Board:" android:paddingEnd="6dp" />
        <Spinner android:id="@+id/spinnerBoard"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <Button android:id="@+id/btnConnect" style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Verbinden &amp; prüfen" />
        <Button android:id="@+id/btnInstall" style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="MicroPython installieren" android:enabled="false" />
        <Button android:id="@+id/btnStart" style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="▶ Start" android:enabled="false" />
        <Button android:id="@+id/btnShow" style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="main.py" />
    </LinearLayout>

    <!-- Tabs SETUP / MAIN / LIB -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <Button android:id="@+id/tabSetup" style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="⚙ SETUP" />
        <Button android:id="@+id/tabMain" style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="▶ MAIN" />
        <Button android:id="@+id/tabLib" style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="🧩 LIB" />
    </LinearLayout>

    <!-- Emoji-/Token-Palette (programmatisch befüllt) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp">
        <LinearLayout android:id="@+id/palette"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Editor des aktiven Tabs -->
    <EditText android:id="@+id/editor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:gravity="top|start"
        android:inputType="textMultiLine|textNoSuggestions"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:importantForAutofill="no"
        android:background="#12151b"
        android:textColor="#e6e9ef"
        android:padding="6dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Log:" android:paddingTop="4dp" android:textStyle="bold" />

    <ScrollView android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">
        <TextView android:id="@+id/log"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="12sp"
            android:padding="4dp" android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
